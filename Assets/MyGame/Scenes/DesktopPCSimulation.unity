      m_PersistentCalls:
        m_Calls: []
    decisionOptions: []
    targetIndexAfterDecision: 
    useAlternatePrefab: 0
    alternatePrefab: {fileID: 0}
    waitUntilReleased: 0
  - speakerName: BennyB0y
    messageText: Willkommen! Freut uns das du hier bist.
    profileImage: {fileID: 1637383507485689528, guid: 510ff1588da59e142972d550ff5f3e67, type: 3}
    delayToNextMessage: 1
    benachrichtigungsSound: {fileID: 0}
    triggerEvent: 0
    OnEvent:
      m_PersistentCalls:
        m_Calls: []
    decisionOptions: []
    targetIndexAfterDecision: 
    useAlternatePrefab: 0
    alternatePrefab: {fileID: 0}
    waitUntilReleased: 0
  - speakerName: Qu1nn_j3lly
    messageText: "Unsere Gruppe besch\xE4ftigt sich schon l\xE4nger mit der\u2026
      Musik\u2026 Wenn du verstehst, was ich meine."
    profileImage: {fileID: 2252148491271298000, guid: db0211d7f9d51834aaf7314ff64fba57, type: 3}
    delayToNextMessage: 1
    benachrichtigungsSound: {fileID: 0}
    triggerEvent: 0
    OnEvent:
      m_PersistentCalls:
        m_Calls: []
    decisionOptions: []
    targetIndexAfterDecision: 
    useAlternatePrefab: 0
    alternatePrefab: {fileID: 0}
    waitUntilReleased: 0
  - speakerName: Qu1nn-j3lly
    messageText: "Najaa, also zumindest mit der \u201EMusik\u201C die wir nicht wahrnehmen
      sollten\u2026!"
    profileImage: {fileID: 0}
    delayToNextMessage: 1
    benachrichtigungsSound: {fileID: 0}
    triggerEvent: 1
    OnEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 266314374}
          m_TargetAssemblyTypeName: ChatBubbleScriptChannelMain, Assembly-CSharp
          m_MethodName: ActivateDecisionCurrent
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    decisionOptions:
    - Hallo...
    - Danke, was meint ihr mit Musik?
    targetIndexAfterDecision: 060000000b000000
    useAlternatePrefab: 0
    alternatePrefab: {fileID: 0}
    waitUntilReleased: 0
  - speakerName: Qu1nn_jelly
    messageText: "Etwas zur\xFCckhaltend, aber trotzdem neugierig was? ^^"
    profileImage: {fileID: 2252148491271298000, guid: db0211d7f9d51834aaf7314ff64fba57, type: 3}
    delayToNextMessage: 0.5
    benachrichtigungsSound: {fileID: 0}
    triggerEvent: 1
    OnEvent:
      m_PersistentCalls:
        m_Calls: []
    decisionOptions: []
    targetIndexAfterDecision: 
    useAlternatePrefab: 0
    alternatePrefab: {fileID: 0}
    waitUntilReleased: 0
  - speakerName: Qu1nn-j3lly
    messageText: "Wir wollen nichts B\xF6ses, aber du musst es doch bestimmt auch
      schon mal bemerkt haben, oder?"
    profileImage: {fileID: 0}
    delayToNextMessage: 1
    benachrichtigungsSound: {fileID: 0}
    triggerEvent: 1
    OnEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 266314374}
          m_TargetAssemblyTypeName: ChatBubbleScriptChannelMain, Assembly-CSharp
          m_MethodName: ActivateDecisionCurrent
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    decisionOptions:
    - Ja
    - Was meinst du?
    targetIndexAfterDecision: 0b00000008000000
    useAlternatePrefab: 0
    alternatePrefab: {fileID: 0}
    waitUntilReleased: 0
  - speakerName: BennyB0y
    messageText: "Naja, du wei\xDFt doch bestimmt, dass Tiere manche Frequenzen wahrnehmen
      k\xF6nnen, die wir Menschen nicht h\xF6ren k\xF6nnen, oder?"
    profileImage: {fileID: 1637383507485689528, guid: 510ff1588da59e142972d550ff5f3e67, type: 3}
    delayToNextMessage: 1
    benachrichtigungsSound: {fileID: 0}
    triggerEvent: 1
    OnEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 266314374}
          m_TargetAssemblyTypeName: ChatBubbleScriptChannelMain, Assembly-CSharp
