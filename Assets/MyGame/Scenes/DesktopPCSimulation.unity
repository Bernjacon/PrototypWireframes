  - speakerName: F4bsi07
    messageText: Hallo.
    profileImage: {fileID: 3046748881700852958, guid: 54e39fa5be415574f9c339293df52639, type: 3}
    delayToNextMessage: 7
    benachrichtigungsSound: {fileID: 0}
    triggerEvent: 0
