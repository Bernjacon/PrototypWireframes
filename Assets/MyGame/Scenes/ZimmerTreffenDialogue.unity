  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a2523ef79cbbc2418786b0ceb1ea04b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 2660526283142039313}
  timeText: {fileID: 1271166824}
  speakerImage: {fileID: 260204982}
  playerImage: {fileID: 0}
  playerBackground: {fileID: 1412485692}
  speakerAnimator: {fileID: 260204981}
  playerAnimator: {fileID: 1199489637}
  boxAnimator: {fileID: 496772884}
  menuBlocker: {fileID: 2107420862}
  uiCamera: {fileID: 171816147}
  hasClock: 1
  playerVisual: {fileID: -4687645564452050167, guid: 1ec8fbfbf899a3e4aaf9ae2b44274adb, type: 3}
  playerAnimation: {fileID: 9100000, guid: 0e88705e6e8c1be489ec595d33b9e5a2, type: 2}
  typeSpeed: 0.01
  indexDSAArray: 0
  isWaitingForDecision: 0
  showDecisionButtons:
  - {fileID: 1005824268}
  - {fileID: 352736181}
  - {fileID: 493646609}
  dialogueBoxRoot: {fileID: 3749513939269074051}
  lmsa: {fileID: 1498806817}
  dsa:
  - textContents: Freut mich das du auch kommen konntest.
    speakerVisual: {fileID: -6392322190737342348, guid: 9619ba2fa58a6fa40b23219d436ef445, type: 3}
    disapearingSpeaker: {fileID: 494288756}
    Speaker: {fileID: 9100000, guid: 51c928bc3f8141c4fa867eeb19248351, type: 2}
    boxAnimation: {fileID: 9100000, guid: 03e38fb84d333304a92459edd51a482f, type: 2}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: "Hey, sch\xF6n dich kennen zu lernen."
    speakerVisual: {fileID: 1379471125480659402, guid: f7901b0373cbd3f4c8f16c2205d825cd, type: 3}
    disapearingSpeaker: {fileID: 2099132686}
    Speaker: {fileID: 9100000, guid: 0b6d5584f3c06484e9974299a8a1a185, type: 2}
    boxAnimation: {fileID: 9100000, guid: 6439eaf1df7fe044f965d5a1bdf220c4, type: 2}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: "Tja Daniel, du f\xFChrst doch was im Schilde, oder"
    speakerVisual: {fileID: 0}
    disapearingSpeaker: {fileID: 2099132686}
    Speaker: {fileID: 0}
    boxAnimation: {fileID: 0}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: "Sonst h\xE4ttest du uns doch nicht eingeladen.."
    speakerVisual: {fileID: 0}
    disapearingSpeaker: {fileID: 2099132686}
    Speaker: {fileID: 0}
    boxAnimation: {fileID: 0}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: Haha, du kennst mich schon zu gut Ben.
    speakerVisual: {fileID: 5110612511535974256, guid: 3c0ca4e678e8d8a41a3a876fc28b6015, type: 3}
    disapearingSpeaker: {fileID: 494288756}
    Speaker: {fileID: 0}
    boxAnimation: {fileID: 9100000, guid: 03e38fb84d333304a92459edd51a482f, type: 2}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: Hast recht, ich hab was vor.
    speakerVisual: {fileID: 5110612511535974256, guid: 3c0ca4e678e8d8a41a3a876fc28b6015, type: 3}
    disapearingSpeaker: {fileID: 494288756}
    Speaker: {fileID: 0}
    boxAnimation: {fileID: 0}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: "Heute ist ein Festival in der Stadt\u2026"
    speakerVisual: {fileID: 5110612511535974256, guid: 3c0ca4e678e8d8a41a3a876fc28b6015, type: 3}
    disapearingSpeaker: {fileID: 494288756}
    Speaker: {fileID: 0}
    boxAnimation: {fileID: 0}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: "Hei\xDFt die meisten Leute werden dort sein und nicht auf andere
      Orte achten."
    speakerVisual: {fileID: 5110612511535974256, guid: 3c0ca4e678e8d8a41a3a876fc28b6015, type: 3}
    disapearingSpeaker: {fileID: 494288756}
    Speaker: {fileID: 0}
    boxAnimation: {fileID: 0}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: Was soll uns das bringen?
    speakerVisual: {fileID: -4687645564452050167, guid: 1ec8fbfbf899a3e4aaf9ae2b44274adb, type: 3}
    disapearingSpeaker: {fileID: 2099132686}
    Speaker: {fileID: 9100000, guid: 6439eaf1df7fe044f965d5a1bdf220c4, type: 2}
    boxAnimation: {fileID: 9100000, guid: baa6a34eefe353f4f9d2902483955a13, type: 2}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: Haha, naja.
    speakerVisual: {fileID: 5110612511535974256, guid: 3c0ca4e678e8d8a41a3a876fc28b6015, type: 3}
    disapearingSpeaker: {fileID: 494288756}
    Speaker: {fileID: 0}
    boxAnimation: {fileID: 9100000, guid: 03e38fb84d333304a92459edd51a482f, type: 2}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: "Wie w\xE4rs wenn wir einfach in den Park gehen und ein Paar Lautsprecher
      dort zerst\xF6ren.."
    speakerVisual: {fileID: 5110612511535974256, guid: 3c0ca4e678e8d8a41a3a876fc28b6015, type: 3}
    disapearingSpeaker: {fileID: 494288756}
    Speaker: {fileID: 0}
    boxAnimation: {fileID: 0}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: "Die Polizei ist mit dem Festival besch\xE4ftigt und wir k\xF6nnen
      endlich auf die Thematik aufmerksam machen"
    speakerVisual: {fileID: 5110612511535974256, guid: 3c0ca4e678e8d8a41a3a876fc28b6015, type: 3}
    disapearingSpeaker: {fileID: 494288756}
    Speaker: {fileID: 0}
    boxAnimation: {fileID: 0}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: "Naja also alle Polizisten werden sicher nicht auf dem Festival
      sein, um aufzupassen.\u201C"
    speakerVisual: {fileID: -4687645564452050167, guid: 1ec8fbfbf899a3e4aaf9ae2b44274adb, type: 3}
    disapearingSpeaker: {fileID: 2099132686}
    Speaker: {fileID: 0}
    boxAnimation: {fileID: 9100000, guid: 6439eaf1df7fe044f965d5a1bdf220c4, type: 2}
    audioClips:
    - {fileID: 8300000, guid: f6dbbd8527bd09a488e6d0009b3d8ce9, type: 3}
    audioMixerGroups: []
    persistentAudioClips: []
    persistentAudioMixers: []
    causesEvent: 0
    eventVariable:
      m_PersistentCalls:
        m_Calls: []
    decisionButtonTexts: []
    targetIndexAfterDecision: 
  - textContents: "Das stimmt schon aber durch die unter Besetzung wird es bestimmt
      l\xE4nger dauern, dass sie vor Ort sein k\xF6nnen."
    speakerVisual: {fileID: 5110612511535974256, guid: 3c0ca4e678e8d8a41a3a876fc28b6015, type: 3}
    disapearingSpeaker: {fileID: 494288756}
    Speaker: {fileID: 0}
